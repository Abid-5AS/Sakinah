{
  "expo": {
    "name": "Sakinah",
    "slug": "sakinah-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#006A6A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sakinah.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "We use Face ID to securely lock your personal journal entries.",
        "NSPhotoLibraryUsageDescription": "Allow Sakinah to save your journal entries as images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#006A6A"
      },
      "package": "com.sakinah.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}
